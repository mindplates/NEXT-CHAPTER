# 로컬 개발용 기본값. compose.yaml 이 이 값들을 읽는다.
# 실제 .env 는 커밋하지 않는다 (.gitignore).
#
# API 키는 여기에 두지 않는다 — AI 프로바이더 키는 관리 화면에서 등록·교체한다
# (코드·환경변수 하드코딩 금지).

POSTGRES_DB=nextchapter
POSTGRES_USER=nextchapter
POSTGRES_PASSWORD=nextchapter

NEO4J_USER=neo4j
NEO4J_PASSWORD=nextchapter

# base64 UUID 22자. 임의 문자열이면 Kafka 가 기동하지 않는다.
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- 백엔드 ---------------------------------------------------------------
# 관리자 JWT 서명 키. 최소 32바이트. 비우면 부팅마다 임의 키를 쓰고 경고한다 —
# 그러면 재기동 시 발급된 관리자 토큰이 전부 무효가 된다.
JWT_SECRET=change-me-to-a-32-byte-or-longer-random-secret

# 최초 관리자 계정. 관리자 계정이 하나도 없을 때 한 번만 쓰인다.
# 비밀번호는 12자 이상이어야 한다.
ADMIN_BOOTSTRAP_EMAIL=admin@nextchapter.local
ADMIN_BOOTSTRAP_NAME=관리자
ADMIN_BOOTSTRAP_PASSWORD=change-me-please

# 소셜 로그인 클라이언트. 비우면 그 제공자의 로그인 버튼이 뜨지 않는다
# (지원 제공자 목록을 설정에서 역산한다). AI 프로바이더 키와 달리 여기 두는 이유는
# 이 값이 부팅 시점의 인증 설정이지 관리자가 런타임에 교체하는 대상이 아니기 때문이다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# AI 프로바이더 API 키 저장용 마스터 키. 없으면 키 등록·조회가 실패한다.
# 이 값이 바뀌면 이미 저장된 암호문을 복호화할 수 없다 — 회전 시 키를 다시 등록해야 한다.
SECRET_KEY=change-me-to-a-long-random-master-key
