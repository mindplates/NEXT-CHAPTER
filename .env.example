# 로컬 개발용 기본값. compose.yaml 이 이 값들을 읽는다.
# 실제 .env 는 커밋하지 않는다 (.gitignore).
#
# API 키는 여기에 두지 않는다 — AI 프로바이더 키는 관리 화면에서 등록·교체한다
# (코드·환경변수 하드코딩 금지).

POSTGRES_DB=nextchapter
POSTGRES_USER=nextchapter
POSTGRES_PASSWORD=nextchapter

NEO4J_USER=neo4j
NEO4J_PASSWORD=nextchapter

# base64 UUID 22자. 임의 문자열이면 Kafka 가 기동하지 않는다.
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
